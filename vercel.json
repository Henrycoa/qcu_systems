{
  "build": {
    "env": {
      "DISABLE_ESLINT_PLUGIN": "true",
      "CI": "false"
    }
  },
  "version": 2,
  "builds": [
    {
      "src": "backend/social-services-app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/backend/social-services-app/$1"
    }
  ]
}
